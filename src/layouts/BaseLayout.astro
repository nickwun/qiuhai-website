---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_CONFIG } from "../config";
import { SITE } from "../consts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  cover?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title = SITE.name,
  description = SITE.description,
  type = "website",
  cover,
  publishedAt,
  updatedAt,
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title === SITE.name ? `${SITE.name}｜${SITE.serviceName}` : `${title}｜${SITE.serviceName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = cover ? new URL(cover, Astro.site ?? Astro.url.origin) : undefined;
const robots = SITE_CONFIG.indexing && !noindex ? "index, follow" : "noindex, nofollow";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f2ea" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={new URL("rss.xml", Astro.site)} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
