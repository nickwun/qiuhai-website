---
import ArticleCard from "../../components/ArticleCard.astro";
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicArticles } from "../../lib/articles";

const posts = await getPublicArticles();
---

<BaseLayout title="文章" description="秋海关于跑步、写作与普通生活的公开文章。">
  <PageIntro eyebrow="Archive" title="文章" description="按时间整理所有公开文章。它们来自不同阶段，也保留各自当时的语气。" />
  <section class="shell page-content">
    {
      posts.length > 0 ? (
        <div class="page-article-list">{posts.map((post) => <ArticleCard post={post} />)}</div>
      ) : (
        <p class="empty-state">正式文章正在整理中。</p>
      )
    }
  </section>
</BaseLayout>
