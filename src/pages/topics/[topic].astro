---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import PageIntro from "../../components/PageIntro.astro";
import { TOPICS } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicArticles } from "../../lib/articles";

export async function getStaticPaths() {
  const allPosts = await getPublicArticles();
  return TOPICS.map((topic) => ({
    params: { topic: topic.slug },
    props: {
      topic,
      posts: allPosts
        .filter(({ data }) => data.category === topic.slug),
    },
  }));
}

interface Props {
  topic: (typeof TOPICS)[number];
  posts: CollectionEntry<"articles">[];
}

const { topic, posts } = Astro.props;
---

<BaseLayout title={`${topic.name}专题`} description={topic.description}>
  <PageIntro eyebrow={`Topic ${topic.marker}`} title={topic.name} description={topic.description} />
  <section class="shell page-content">
    {
      posts.length > 0 ? (
        <div class="page-article-list">{posts.map((post) => <ArticleCard post={post} />)}</div>
      ) : (
        <p class="empty-state">这个专题暂时还没有公开文章。</p>
      )
    }
  </section>
</BaseLayout>
