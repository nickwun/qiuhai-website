---
import ArticleCard from "../components/ArticleCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { CATEGORY_NAMES, SITE, TOPICS } from "../consts";
import { getProjects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicArticles } from "../lib/articles";

const posts = await getPublicArticles();
const featuredPosts = posts.filter(({ data }) => data.featured).slice(0, 6);
const latestPosts = posts.slice(0, 5);
const featuredProjects = getProjects().filter((project) => project.featured);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-inner">
      <div>
        <p class="eyebrow">个人博客 · Qiuhai</p>
        <h1>{SITE.name}</h1>
        <p class="hero-subtitle">{SITE.subtitle}</p>
      </div>
      <p class="hero-note">
        我是一名长期跑者和写作者。<br />
        这里收录我关于跑步、创作和普通生活的长期记录，<br />
        也展示正在进行的作品与项目。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>推荐文章</h2>
        <p>从跑步、创作和生活里，选出几篇适合从这里开始的文字。</p>
      </div>
      {
        featuredPosts.length > 0 ? (
          <div class="article-grid">{featuredPosts.map((post) => <ArticleCard post={post} compact />)}</div>
        ) : (
          <p class="empty-state">正式文章正在整理中，确认公开后会从这里开始更新。</p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>三个主题</h2>
        <p>它们并不总有清楚的边界，但大多数文字会从其中一个地方出发。</p>
      </div>
      <div class="topic-grid">
        {
          TOPICS.map((topic) => (
            <a class="topic-card" href={`/topics/${topic.slug}/`}>
              <span class="topic-marker">{topic.marker}</span>
              <h3>{topic.name}</h3>
              <p>{topic.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>最新文章</h2>
        <a class="text-link" href="/articles/">查看全部文章 →</a>
      </div>
      {
        latestPosts.length > 0 ? (
          <ol class="latest-list">
            {latestPosts.map((post) => (
            <li>
              <time datetime={post.data.publishedAt.toISOString()}>
                {post.data.publishedAt.toLocaleDateString("zh-CN")}
              </time>
              <a href={`/articles/${post.data.slug}/`}>{post.data.title}</a>
              <span>{CATEGORY_NAMES[post.data.category]}</span>
            </li>
            ))}
          </ol>
        ) : (
          <p class="empty-state">这里暂时没有正式文章。</p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>作品与项目</h2>
        <a class="text-link" href="/works/">查看作品页 →</a>
      </div>
      <div class="works-preview">
        {featuredProjects.map((project) => <ProjectCard project={project} compact />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell about-strip">
      <h2>关于秋海</h2>
      <div>
        <p>我是秋海，一名长期跑者和写作者。</p>
        <p>我跑步十多年，也持续用文字记录训练、家庭和生活中的变化。最近开始学习视频创作和 AI 编程，尝试把过去积累的文章、笔记和经验整理成可以长期保存的作品。</p>
        <a class="text-link" href="/about/">了解更多 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
