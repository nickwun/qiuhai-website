---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import { CATEGORY_NAMES, SITE, TOPICS } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featuredPosts = posts.filter(({ data }) => data.featured).slice(0, 6);
const latestPosts = posts.slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-inner">
      <div>
        <p class="eyebrow">个人博客 · Qiuhai</p>
        <h1>{SITE.name}</h1>
        <p class="hero-subtitle">{SITE.subtitle}</p>
      </div>
      <p class="hero-note">在这里保存公开的文字、作品和仍在进行中的项目。慢一点，但尽量写得诚实。</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>推荐文章</h2>
        <p>从跑步、创作和生活里，选出几篇适合从这里开始的文字。</p>
      </div>
      <div class="article-grid">
        {featuredPosts.map((post) => <ArticleCard post={post} compact />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>三个主题</h2>
        <p>它们并不总有清楚的边界，但大多数文字会从其中一个地方出发。</p>
      </div>
      <div class="topic-grid">
        {
          TOPICS.map((topic) => (
            <a class="topic-card" href={`/topics/${topic.slug}/`}>
              <span class="topic-marker">{topic.marker}</span>
              <h3>{topic.name}</h3>
              <p>{topic.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>最新文章</h2>
        <a class="text-link" href="/articles/">查看全部文章 →</a>
      </div>
      <ol class="latest-list">
        {
          latestPosts.map((post) => (
            <li>
              <time datetime={post.data.publishedAt.toISOString()}>
                {post.data.publishedAt.toLocaleDateString("zh-CN")}
              </time>
              <a href={`/articles/${post.data.slug}/`}>{post.data.title}</a>
              <span>{CATEGORY_NAMES[post.data.category]}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>作品与项目</h2>
        <a class="text-link" href="/works/">查看作品页 →</a>
      </div>
      <div class="works-preview">
        <article class="work-card">
          <p class="work-kicker">WRITING</p>
          <h3>秋海的公开写作</h3>
          <p>逐步整理公众号与其他平台中已经确认公开的终稿，让内容拥有稳定、可检索的归档。</p>
        </article>
        <article class="work-card">
          <p class="work-kicker">PROJECT</p>
          <h3>个人内容实验</h3>
          <p>用小项目练习写作、设计与工具搭建。这里只展示适合公开的阶段性结果。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell about-strip">
      <h2>关于秋海</h2>
      <div>
        <p>这是秋海的个人网站，主要记录跑步、写作与普通生活，也用来归档作品和正在做的项目。</p>
        <a class="text-link" href="/about/">了解更多 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
